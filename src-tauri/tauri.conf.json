{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oso",
  "version": "0.4.0",
  "identifier": "dev.seyadog.oso",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "oso", "width": 1400, "height": 850, "minWidth": 720, "minHeight": 460 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Utility",
    "shortDescription": "A graphical SSH workspace",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
